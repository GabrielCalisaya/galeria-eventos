# Copiá este archivo como .env.local para probar en tu compu.
# En producción estos valores se cargan como secretos de GitHub (ver README).

# Supabase → Project Settings → API Keys (Publishable key, empieza con sb_publishable_)
VITE_SUPABASE_URL=https://TU-PROYECTO.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx

# Dirección pública del bucket de R2 (dominio propio o r2.dev), sin barra final
VITE_R2_PUBLIC_URL=https://fotos-cdn.tudominio.com

# Emails de administradores autorizados a confirmar transferencias, separados por coma.
# Configurar en los secretos de Supabase; no se expone en el frontend.
TRANSFER_ADMIN_EMAILS=admin@tudominio.com

# Alias (o CBU/CVU) donde se reciben las transferencias. Configurar en los secretos de Supabase.
TRANSFER_ALIAS=tu.alias.mp
